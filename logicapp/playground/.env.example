# Copy this file to ".env" and paste your Logic App HTTP trigger URL.
# The URL contains a secret signature (sig=...). The real ".env" is gitignored - never commit it.
LOGIC_APP_URL=https://prod-XX.<region>.logic.azure.com:443/workflows/<id>/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=REPLACE_ME
