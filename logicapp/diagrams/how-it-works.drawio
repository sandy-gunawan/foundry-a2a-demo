<mxfile host="app.diagrams.net">
  <diagram id="how-it-works" name="How it works">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Caller -->
        <mxCell id="caller" value="📞 Caller (Dinda)&#10;&quot;I was double charged&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Logic App container (the switchboard) -->
        <mxCell id="la" value="Azure Logic App — the switchboard (Consumption)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="380" height="560" as="geometry" />
        </mxCell>

        <mxCell id="trigger" value="① HTTP trigger&#10;(the phone rings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="classify" value="② Classify (model gpt-5.4-mini)&#10;receptionist listens → intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="180" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="setintent" value="③ Set Intent&#10;write down the department" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="260" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="switch" value="④ Route by intent (Switch)&#10;which extension?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="340" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="callbilling" value="⑤ CallBilling (HTTP)&#10;transfer → Billing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="460" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="calltech" value="⑤ CallTech (HTTP)&#10;transfer → Tech Support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="460" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Foundry container -->
        <mxCell id="foundry" value="Microsoft Foundry — the departments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="agtbilling" value="agt-billing" style="html=1;image;image=img/lib/azure2/ai_machine_learning/Cognitive_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fabriciq" value="Fabric IQ&#10;(filing cabinet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="175" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agttech" value="agt-techsupport" style="html=1;image;image=img/lib/azure2/ai_machine_learning/Cognitive_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="foundryiq" value="Foundry IQ&#10;(filing cabinet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="365" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Identity -->
        <mxCell id="identity" value="Managed identity (staff badge)&#10;role: Foundry Agent Consumer&#10;audience: https://ai.azure.com" style="html=1;image;image=img/lib/azure2/identity/Azure_Active_Directory.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=10;fillColor=#E1D5E7;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="caller" target="trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="trigger" target="classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="classify" target="setintent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="setintent" target="switch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="billing" style="endArrow=block;html=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="switch" target="callbilling">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="techsupport" style="endArrow=block;html=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="switch" target="calltech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="agent_reference" style="endArrow=block;html=1;strokeColor=#82B366;fontSize=10;" edge="1" parent="1" source="callbilling" target="agtbilling">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="agent_reference" style="endArrow=block;html=1;strokeColor=#82B366;fontSize=10;" edge="1" parent="1" source="calltech" target="agttech">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;strokeColor=#82B366;" edge="1" parent="1" source="agtbilling" target="fabriciq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;strokeColor=#82B366;" edge="1" parent="1" source="agttech" target="foundryiq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="answer relayed back" style="endArrow=block;html=1;dashed=1;strokeColor=#9673A6;fontSize=10;" edge="1" parent="1" source="la" target="caller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="badge (auth)" style="endArrow=open;html=1;dashed=1;strokeColor=#9673A6;fontSize=10;" edge="1" parent="1" source="identity" target="callbilling">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
